# /opt/blitzmove/backend.env (chmod 600). Placeholders only: real values never go into Git.
APP_NAME=BlitzMove
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # base64:..., generated once by deploy.sh
APP_URL=https://example.com
FRONTEND_URL=https://example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=blitzmove
DB_USERNAME=blitzmove
# DB_HOST and DB_PASSWORD come from docker-compose.yml / .env

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Docker network: lets Laravel see the visitor IP that nginx/Next.js forward (rate limits).
TRUSTED_PROXIES=172.16.0.0/12

SANCTUM_TOKEN_EXPIRATION_MINUTES=720
SANCTUM_REMEMBER_EXPIRATION_DAYS=30

MAIL_MAILER=log               # password-reset emails need real SMTP settings here
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=BlitzMove

MAP_PROVIDER=mapbox
ROUTING_PROVIDER=mapbox
MAPBOX_SECRET_TOKEN=

DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=       # required for the seeder to create the Super Admin in production
SEED_DEV_USERS=false
SEED_DEMO_DATA=false
