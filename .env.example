APP_NAME=BlitzMove
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
# Public URL of the Next.js app (used in password reset emails)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=blitzmove
DB_USERNAME=blitzmove
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@blitzmove.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum API tokens (Bearer). Stateful SPA cookies are not used.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION_MINUTES=720
SANCTUM_REMEMBER_EXPIRATION_DAYS=30

# First Super Admin created by `php artisan db:seed` (DefaultAdminSeeder). Never overwrites an existing account.
# In production an empty DEFAULT_ADMIN_PASSWORD means no account is created; elsewhere a random one is printed once.
# (The older SEED_ADMIN_NAME / SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD names are still read as fallbacks.)
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=superadmin@blitzmove.local
DEFAULT_ADMIN_PASSWORD=
# Development sample accounts, one per role (admin@, dispatcher@, operations@, fleet@, driver@, maintenance@, viewer@blitzmove.local).
# Off by default; refused in production unless ALLOW_DEV_USERS_IN_PRODUCTION=true. Empty password = random, printed once.
SEED_DEV_USERS=false
DEV_USERS_PASSWORD=
# Sample vehicles, drivers, orders, trips, fuel and documents (defaults to true outside production)
SEED_DEMO_DATA=true

# Optional integrations - leave empty until configured
MAP_PROVIDER=
ROUTING_PROVIDER=
# Mapbox secret (sk.) token used server-side for geocoding, directions, optimization and static map images.
MAPBOX_SECRET_TOKEN=
