APP_NAME=BlitzMove
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public URL of the Next.js app (used in password reset emails)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blitzmove
DB_USERNAME=blitzmove
DB_PASSWORD=
# Used by the MySQL container only
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@blitzmove.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum API tokens (Bearer). Stateful SPA cookies are not used.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION_MINUTES=720
SANCTUM_REMEMBER_EXPIRATION_DAYS=30

# First administrator created by `php artisan db:seed`.
# Leave SEED_ADMIN_PASSWORD empty to have a random password generated and printed once.
SEED_ADMIN_NAME="BlitzMove Administrator"
SEED_ADMIN_EMAIL=admin@blitzmove.local
SEED_ADMIN_PASSWORD=
# Sample vehicles, drivers, orders, trips, fuel and documents (defaults to true outside production)
SEED_DEMO_DATA=true

# Optional integrations - leave empty until configured
MAP_PROVIDER=
ROUTING_PROVIDER=
